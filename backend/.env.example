# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/excursi?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payments (Razorpay). Leave unset to run payments in local mock mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Platform commission kept from each paid booking (operator gets the rest).
PLATFORM_COMMISSION_RATE=0.15

# Admin seed (npm run seed:admin). Admins are never self-registered.
ADMIN_EMAIL=admin@excursi.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Excursi Admin
